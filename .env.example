# Copy to .env and replace all CHANGE_ME values before starting.
# 这是智记 SmartBook 服务端(SmartBook-Cloud 自托管)的环境变量模板。
# 统一使用你已部署的服务器地址（替换为实际地址，如 https://your-server:8888/）
# 若需本地部署，可把 CORS_ORIGINS 改回 http://localhost:8869。
#
# 本文件经 compose 的 env_file 整份注入容器 —— 服务端支持的任何环境变量
# (server/src/config.py 的 Settings 字段,如 AI_* / EMBEDDING_* / REGISTRATION_ENABLED /
# SCHEDULER_TIMEZONE 等)写进 .env 即生效;下面只列出常用项。

# 访问端口（服务器本地容器端口；对外由反向代理映射到域名 :8888，见 docs/deploy/reverse-proxy.md）
SMARTBOOK_PORT=8869

# 应用相关(显示名「SmartBook 智记」由服务端代码内置,不依赖 .env)
APP_ENV=production
API_PREFIX=/api/v1
WEB_STATIC_DIR=/app/static

# 数据库。与 docker-compose.yml 的 smartbook-db (PostgreSQL) 服务对齐。
# SMARTBOOK_DB_PASSWORD 必填 —— 与 JWT_SECRET 一样 fail-fast,未设置(或没改
# 占位值)时 compose 启动/插值校验会直接报错;其余 DB_* 变量默认 smartbook。
# 连接串默认由这些变量拼出,无需手动写;仅外部数据库等特殊场景才整串覆盖:
# SMARTBOOK_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
SMARTBOOK_DB_DATABASE=smartbook
SMARTBOOK_DB_USERNAME=smartbook
SMARTBOOK_DB_PASSWORD=CHANGE_ME

# ===== 必填：JWT 密钥（改成你自己的 32+ 字节强随机串）=====
# 生成方式（PowerShell）：
# $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 跨域来源（服务器地址；若本地部署 / 客户端来源变化需同步调整）
CORS_ORIGINS=https://your-server:8888

# 限流
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# 备份
# 存储路径说明:附件 / AI 记账截图 / 备份 / rclone 配置等全部由 DATA_DIR
# 派生(容器镜像默认 DATA_DIR=/data,挂 volume 即全量持久化),无需逐项配置。
# 需要单独挪某个子目录时才显式覆盖,例如:
# BACKUP_STORAGE_DIR=/data/backups
BACKUP_MAX_UPLOAD_BYTES=67108864

ALLOW_APP_RW_SCOPES=true

# 是否开放注册（家庭自用建议 false，用初始 admin 或不影响多用户则 true）
# REGISTRATION_ENABLED=false

# ===== AI 文档 Q&A（可选）=====
# 走 SiliconFlow + BAAI/bge-m3，注册 https://siliconflow.cn 拿 key 填入即可启用。
# 不填则「问 AI」功能 fallback 到跳官网搜索，不影响其它功能。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# ===== 汇率代理（多币种，可选）=====
# 经 env_file 注入容器生效;关闭代理把 ENABLED 改 false。
EXCHANGE_RATE_PROXY_ENABLED=true
EXCHANGE_RATE_CACHE_TTL_HOURS=12
# EXCHANGE_RATE_UPSTREAM=
